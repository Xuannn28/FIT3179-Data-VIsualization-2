{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 600,
  "height": 600,
  "padding": 5,
  "title": {
    "text": "Air Pollutant (2017, 2019, 2021)",
    "fontSize": 20,
    "anchor": "middle"
  },
  "data": [
    {
      "name": "pollutants",
      "url": "https://raw.githubusercontent.com/Xuannn28/FIT3179-Data-VIsualization-2/main/data/pollutants_cleaned.csv",
      "format": {"type": "csv"}
    },
    {
      "name": "tree",
      "source": "pollutants",
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "partition",
          "field": "value",
          "sort": {"field": "value", "order": "descending"},
          "size": [6.28318, 250],
          "as": ["a0", "r0", "a1", "r1", "depth", "children"]
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "arc",
      "from": {"data": "tree"},
      "encode": {
        "enter": {
          "x": {"signal": "width / 2"},
          "y": {"signal": "height / 2"},
          "startAngle": {"field": "a0"},
          "endAngle": {"field": "a1"},
          "innerRadius": {"field": "r0"},
          "outerRadius": {"field": "r1"},
          "fill": {"scale": "color", "field": "id"},
          "stroke": {"value": "white"},
          "tooltip": {
            "signal": "'Pollutant/Year: ' + datum.id + '\\n' + 'Category: ' + datum.parent + '\\n' + 'Value: ' + datum.value"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": {"data": "tree", "field": "id"},
      "range": {"scheme": "tableau20"}
    }
  ]
}
