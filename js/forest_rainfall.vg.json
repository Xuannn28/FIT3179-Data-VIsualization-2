{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bubble heatmap showing classified rainfall and forest area (in kha) across states and years.",
  "width": 700,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/Xuannn28/FIT3179-Data-VIsualization-2/refs/heads/main/data/forest_rainfall_scatter.csv"
  },
  "transform": [
    {
      "calculate": "datum.area / 1000",
      "as": "area_kha"
    }
  ],
  "mark": {
    "type": "circle",
    "stroke": "white",
    "strokeWidth": 0.3,
    "opacity": 1
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "axis": {"labelAngle": 0, "titleColor": "#333"}
    },
    "y": {
      "field": "state",
      "type": "ordinal",
      "sort": "-x",
      "title": "State",
      "axis": {
        "titleColor": "#333"
      }
    },
    "color": {
      "field": "Total Rainfall in millimetres",
      "type": "quantitative",
      "title": "Total Rainfall (mm)",
      "bin": {"maxbins": 5},
      "scale": {
        "range": ["#b3d9ea", "#80b1d3", "#2171b5", "#08306b"]
      },
      "legend": {"orient": "bottom", "direction": "horizontal", "titleColor": "#333", "titleFontWeight":"bold"}
    },
    "size": {
      "field": "area_kha",
      "type": "quantitative",
      "title": "Forest Area (kha)",
      "scale": {"domain": [0, 5000], "range": [20, 1000]},
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "titlePadding": 10,
        "offset": 40, 
        "titleColor": "#333", 
        "titleFontWeight":"bold"
      }
    },
    "tooltip": [
      {"field": "state", "type": "nominal"},
      {"field": "Year", "type": "ordinal"},
      {"field": "Total Rainfall in millimetres", "type": "quantitative", "title": "Total Rainfall (mm)"},
      {"field": "area_kha", "type": "quantitative", "title": "Forest Area (kha)"}
    ]
  },
  "title": {
    "text": "Rainfall Intensity and Forest Reserve Area by State and Year (2003–2021)",
    "font": "Arial",
    "fontSize": 18,
    "anchor": "start",
     "color": "#333",
     "fontWeight":700
  },
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {"labelFontSize": 12, "titleFontSize": 14, "titleColor": "#333", "labelColor": "#333", "titleFontWeight":"bold"}
  }
}
