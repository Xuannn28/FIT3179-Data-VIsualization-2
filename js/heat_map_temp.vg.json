{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Overview + Detail: Pollution vs Temperature (2000–2002)",
  "data": {
    "url": "harmonized_pollution_temp.csv"
  },
  "vconcat": [
    {
      "width": 600,
      "height": 150,
      "mark": "line",
      "encoding": {
        "x": {"field": "Year", "type": "ordinal", "title": "Year"},
        "y": {"field": "AvgPollution", "type": "quantitative", "title": "Average Pollution (PM Index)"},
        "color": {"field": "State", "type": "nominal", "legend": {"title": "State"}}
      },
      "selection": {
        "brush": {"type": "interval", "encodings": ["x"]}
      },
      "transform": [
        {"filter": "datum.AvgPollution != null"}
      ]
    },
    {
      "width": 600,
      "height": 250,
      "mark": "circle",
      "encoding": {
        "x": {"field": "MeanTemp", "type": "quantitative", "title": "Mean Temperature (°C)"},
        "y": {"field": "AvgPollution", "type": "quantitative", "title": "Average Pollution (PM Index)"},
        "color": {"field": "State", "type": "nominal"},
        "tooltip": [
          {"field": "Year"},
          {"field": "Selected Stations"},
          {"field": "AvgPollution"},
          {"field": "MeanTemp"},
          {"field": "State"}
        ]
      },
      "transform": [
        {"filter": {"selection": "brush"}}
      ]
    }
  ]
}
