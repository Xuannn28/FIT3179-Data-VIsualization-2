{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500, 
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/Xuannn28/FIT3179-Data-VIsualization-2/main/data/rainfall_pollution_ready.csv"
  },
  "mark":{
    "type": "boxplot",
    "size": 40   
  },
  "encoding": {
    "x": {
      "field": "PollutionCategory",
      "type": "ordinal",
      "title": "Pollution Category",
      "axis": {
        "labelAngle": 0,       
        "labelFontSize": 14,   
        "titleFontSize": 16
      }
    },
    "y": {
      "field": "Rainfall_mm",
      "type": "quantitative",
      "title": "Total Rainfall (mm)"
    },
    "color": {
      "field": "PollutionCategory",
      "type": "ordinal",
      "scale": {
        "domain": ["Low", "Medium", "High"],
        "range": ["#1f77b4", "#e69f00", "#d55e00"]
      },
      "legend": {"title": "Pollution Category"}
    }
  }
}
