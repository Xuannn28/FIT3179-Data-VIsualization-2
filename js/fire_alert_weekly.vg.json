{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "vconcat": [
    {
      "width": 700,
      "height": 400,
      "title": {
        "text": "Weekly Fire Alerts (2012–2024)",
        "fontSize": 18,
        "anchor": "start",
         "color": "#555"
      },
      "data": {
        "url": "https://raw.githubusercontent.com/Xuannn28/FIT3179-Data-VIsualization-2/refs/heads/main/data/malaysia_fire_alerts_clean.csv"
      },
      "transform": [
        { "filter": { "param": "yearRange" } }
      ],
      "mark": { "type": "line", "strokeWidth": 2, "color": "#ac3b1c" },
      "encoding": {
        "x": {
          "field": "alert_date",
          "type": "temporal",
          "title": "Date",
          "axis": { "format": "%b %Y", "labelAngle": 0 ,"grid": false }
        },
        "y": {
          "field": "alert__count",
          "type": "quantitative",
          "title": "Weekly Fire Alerts (count)"
        },
        "tooltip": [
          { "field": "year_month_day", "title": "Year-Month-Day" },
          { "field": "alert__count", "title": "Fire Alerts (count)", "format": "," }
        ]
      }
    },
    {
      "description": "Overview chart for selecting year range",
      "width": 700,
      "height": 80,
      "data": {
        "url": "https://raw.githubusercontent.com/Xuannn28/FIT3179-Data-VIsualization-2/refs/heads/main/data/malaysia_fire_alerts_clean.csv"
      },
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.7,
        "color": "#ac3b1c"
      },
      "encoding": {
        "x": {
          "field": "alert_date",
          "type": "temporal",
          "title": "Year",
          "axis": { "format": "%Y" , "grid": false }
        },
        "y": {
          "aggregate": "sum",
          "field": "alert__count",
          "type": "quantitative",
          "title": "Total Fire Alerts"
        }
      },
      "params": [
        {
          "name": "yearRange",
          "select": { "type": "interval", "encodings": ["x"] }
        }
      ],
      "title": {
        "text": "Select Year Range to Zoom (Click and Drag)",
        "fontSize": 14,
        "anchor": "start"
      }
    }
  ],
  "config": {
    "axis": { "labelFontSize": 12, "titleFontSize": 13 },
    "legend": { "labelFontSize": 12, "titleFontSize": 13 }
  }
}
